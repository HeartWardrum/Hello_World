from sqlalchemy import text
import pandas as pd

def batch_update_from_dataframe(session, df, model_class, key_column='company_id', update_columns=None):
    """
    海量数据批量更新 - 临时表 + MERGE INTO 方案
    
    适用场景：
    - 几十万到几千万行的更新
    - 需要更新多个字段
    - 需要最优性能
    
    Args:
        session: SQLAlchemy session
        df: DataFrame，包含 key_column 和要更新的所有字段
        model_class: SQLAlchemy 模型类
        key_column: 关联键列名（通常是主键）
        update_columns: 要更新的列名列表，None 表示更新除 key_column 外的所有列
    """
    table_name = model_class.__tablename__
    
    # 1. 确定要更新的字段
    if update_columns is None:
        update_columns = [col for col in df.columns if col != key_column]
    
    # 2. 准备数据：去重 + 只保留需要的列
    columns_to_keep = [key_column] + update_columns
    df_to_update = df[columns_to_keep].drop_duplicates(subset=[key_column])
    
    if len(df_to_update) == 0:
        print("没有需要更新的数据")
        return 0
    
    # 3. 创建临时表（使用随机后缀避免并发冲突）
    import uuid
    temp_table = f"temp_update_{table_name}_{uuid.uuid4().hex[:8]}"
    
    # 将 DataFrame 写入临时表
    df_to_update.to_sql(temp_table, session.bind, if_exists='replace', index=False)
    
    # 4. 构建 MERGE INTO 语句
    # SET 子句：为每个要更新的字段生成 t.字段 = s.字段
    set_clauses = ', '.join([f"t.{col} = s.{col}" for col in update_columns])
    
    merge_sql = text(f"""
        MERGE INTO {table_name} t
        USING {temp_table} s
        ON (t.{key_column} = s.{key_column})
        WHEN MATCHED THEN UPDATE SET {set_clauses}
    """)
    
    # 5. 执行
    try:
        result = session.execute(merge_sql)
        session.commit()
        updated_count = result.rowcount
        print(f"成功更新 {updated_count} 条数据，更新字段: {update_columns}")
    except Exception as e:
        session.rollback()
        print(f"更新失败: {e}")
        raise
    finally:
        # 6. 清理临时表
        try:
            session.execute(text(f"DROP TABLE {temp_table}"))
        except:
            pass
    
    return updated_count
